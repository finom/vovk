---
imports: ['vovk/internal']
---
<%- t.getFirstLineBanner() %>
import type { VovkRequest, VovkStreamAsyncIterable } from 'vovk';

<% const { applyComponentsSchemas, toTypeName, toTypeNames } = t.imports['vovk/internal'];
const mixins = Object.values(t.schema.segments).filter((segment) => segment.emitSchema && segment.segmentType === 'mixin');
// the type names vovk gives the x-tsType of a component ref, and one namespace per handler
const handlerNamespaces = new Map(
  mixins.flatMap((segment) =>
    Object.values(segment.controllers).map((controllerSchema) => [controllerSchema, toTypeNames(Object.keys(controllerSchema.handlers))])
  )
); %>

export namespace Mixins {
  <% for (const segment of mixins) { %>
    <% const schemas = segment.meta?.openAPIObject?.components?.schemas; %>
    <% if (schemas) { const typeNames = toTypeNames(Object.keys(schemas)); %>
      export namespace <%= toTypeName(segment.segmentName) %> {
        <% for (const [componentName, componentSchema] of Object.entries(schemas)) { %>
          <%- t.compileJSONSchemaToTypeScriptType(applyComponentsSchemas(componentSchema, schemas, segment.segmentName, false), typeNames.get(componentName), segment.meta.openAPIObject.components, { dontCreateRefTypes: true }) %>
        <% } %>
      }
    <% } %>
  <% } %>
}

export namespace Types {
  <% for (const segment of mixins) { %>
    export namespace <%= toTypeName(segment.segmentName) %> {
      <% for (const controllerSchema of Object.values(segment.controllers)) { %>
        export namespace <%= controllerSchema.rpcModuleName %> {
          <% for (const [handlerName, handlerSchema] of Object.entries(controllerSchema.handlers)) { %>
            export namespace <%= handlerNamespaces.get(controllerSchema).get(handlerName) %> {
              <%- t.compileJSONSchemaToTypeScriptType(handlerSchema.validation?.body, 'Body') %>
              <%- t.compileJSONSchemaToTypeScriptType(handlerSchema.validation?.query, 'Query') %>
              <%- t.compileJSONSchemaToTypeScriptType(handlerSchema.validation?.params, 'Params') %>
              <%- t.compileJSONSchemaToTypeScriptType(handlerSchema.validation?.output, 'Output') %>
              <%- t.compileJSONSchemaToTypeScriptType(handlerSchema.validation?.iteration,  'Iteration') %>
            }
          <% } %>
        }
      <% } %>
    }
  <% } %>
}

<% const getType = (segment, controllerSchema, handlerName, validationType) => {
  if (!controllerSchema.handlers[handlerName].validation?.[validationType]) return 'null';
  return [
    'Types',
    toTypeName(segment.segmentName),
    controllerSchema.rpcModuleName,
    handlerNamespaces.get(controllerSchema).get(handlerName),
    t._.upperFirst(validationType),
  ].join('.');
} %>

export type Controllers = {
    <% for (const segment of mixins) { %>
      <% for (const controllerSchema of Object.values(segment.controllers)) { %>
      <%- JSON.stringify(controllerSchema.rpcModuleName) %>: {
        <% for (const [handlerName, handlerSchema] of Object.entries(controllerSchema.handlers)) { %>
          <%- JSON.stringify(handlerName) %>: (req: VovkRequest<
            <%- getType(segment, controllerSchema, handlerName, 'body') %>,
            <%- getType(segment, controllerSchema, handlerName, 'query') %>,
            <%- getType(segment, controllerSchema, handlerName, 'params')  %>
          >) => <%- handlerSchema.validation?.output ? `Promise<${getType(segment, controllerSchema, handlerName, 'output')}>` : handlerSchema.validation?.iteration ? `Promise<VovkStreamAsyncIterable<${getType(segment, controllerSchema, handlerName, 'iteration')}>>` : 'Promise<any>' %>,
        <% } %>
      };
     <% } %>
    <% } %>
};
