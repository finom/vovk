{
  "name": "vovk-ajv",
  "version": "0.1.0",
  "description": "Client-side JSON Schema validation library for Vovk.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "tsc": "tsc --noEmit",
    "prepublishOnly": "node -e \"if (!process.env.GITHUB_ACTIONS) { console.error('Publish from CI: PACKAGE=<name> npm run <type> tags a release, and the tag publishes it'); process.exit(1) }\"",
    "ncu": "npm-check-updates -u"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finom/vovk.git",
    "directory": "packages/vovk-ajv"
  },
  "keywords": [
    "vovk",
    "json",
    "ajv",
    "validation"
  ],
  "author": "Andrey Gubanov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/finom/vovk/issues"
  },
  "homepage": "https://vovk.dev/imports",
  "peerDependencies": {
    "vovk": "^4.0.0-0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1"
  }
}
