---
imports: ['vovk-rust']
---
<%- t.getFirstLineBanner() %>
<% const vars = {
    convertJSONSchemasToRustTypes: t.imports['vovk-rust'].convertJSONSchemasToRustTypes,
    getBodyKind: t.imports['vovk-rust'].getBodyKind,
    getTextContentType: t.imports['vovk-rust'].getTextContentType,
    getBinaryContentType: t.imports['vovk-rust'].getBinaryContentType,
    getBinaryBodyVariants: t.imports['vovk-rust'].getBinaryBodyVariants,
    toRustIdent: t.imports['vovk-rust'].toRustIdent,
    getFunctionNames: t.imports['vovk-rust'].getFunctionNames,
    toRustDocLines: t.imports['vovk-rust'].toRustDocLines,
    toRustCommentText: t.imports['vovk-rust'].toRustCommentText,
    toRustString: t.imports['vovk-rust'].toRustString,
}; %>
mod http_request;
mod read_full_schema;

pub use crate::http_request::HttpException;
<% Object.entries(t.schema.segments).forEach(([segmentName, segment]) => {
    const segmentMeta = t.segmentMeta?.[segmentName] ?? {};
    // a configured origin or root entry gives the segment its own root, a mixin's root already includes its path
    const apiRoot = segmentMeta.forceApiRoot ?? t.apiRoot ?? '';
    const segmentPath = segment.forceApiRoot ? '' : typeof segmentMeta.segmentNameOverride === 'string' ? segmentMeta.segmentNameOverride : segmentName;
    Object.values(segment.controllers).forEach((controllerSchema) => {
    const functionNames = vars.getFunctionNames(Object.keys(controllerSchema.handlers), t._.snakeCase); %>
pub mod <%= vars.toRustIdent(t._.snakeCase(controllerSchema.rpcModuleName)) %> {
    #[allow(unused_imports)]
    use crate::http_request::{Endpoint, HttpException, RequestBody, http_request, http_request_stream};
    #[allow(unused_imports)]
    use futures_util::Stream;
    use std::collections::HashMap;
    #[allow(unused_imports)]
    use std::pin::Pin;
<% Object.entries(controllerSchema.handlers).forEach(([handlerNameOriginal, handlerSchema]) => { 
    const { validation, operationObject, httpMethod } = handlerSchema;
    const handlerName = functionNames.get(handlerNameOriginal);
    const url = [apiRoot.replace(/\/+$/, ''), ...[segmentPath, controllerSchema.prefix ?? '', handlerSchema.path].map((part) => t._.trim(part, '/'))].filter(Boolean).join('/');
    // a path with {name} placeholders takes params, with or without a params schema
    const paramsType = validation?.params ? `${handlerName}_::params` : /\{[^}]+\}/.test(`${controllerSchema.prefix ?? ''}/${handlerSchema.path}`) ? 'HashMap<String, String>' : '()';
    %>
    // <%- vars.toRustCommentText(`${controllerSchema.rpcModuleName}.${handlerName} ${httpMethod} \`${url}\``) %>
<%- 
vars.convertJSONSchemasToRustTypes({ 
    schemas: {
        body: validation?.body,
        query: validation?.query,
        params: validation?.params,
        // a mixin keeps its components once, in the segment's meta: a response schema gets its $defs back
        output: t.reattachMixinDefs(validation?.output, segment),
        iteration: t.reattachMixinDefs(validation?.iteration, segment)
    },
    rootName: handlerName,
    pad: 4 
})
%>
<%- ([
    operationObject?.summary ? `Summary: ${operationObject.summary}` : '',
    operationObject?.description ? `Description: ${operationObject.description}` : '',
    validation?.params?.description ? `Params: ${validation?.params?.description}` : '',
    validation?.body?.description ? `Body: ${validation?.body?.description}`: '',
    validation?.query?.description ? `Query: ${validation?.query?.description}`: '',
    validation?.output?.description ? `Returns: ${validation?.output?.description}`: ''
]).filter(Boolean).flatMap((s) => vars.toRustDocLines(s)).map((s) => ' '.repeat(4) + '///' + (s ? ' ' + s : '')).join('\n') %>
<%
    const bodyKind = vars.getBodyKind(validation?.body);
    const typedBody = bodyKind === 'json' || bodyKind === 'urlencoded';
    // the file variants of a file-or-JSON union go out as bytes
    const binaryVariants = vars.getBinaryBodyVariants(validation?.body);
    const binaryArms = binaryVariants.map((variant) => `                ${handlerName}_::body::${variant}(bytes) => RequestBody::Binary(bytes, ${vars.toRustString(vars.getBinaryContentType(validation?.body))}),\n`).join('');
    const requestBody = {
        none: 'RequestBody::None',
        json: binaryVariants.length ? `match body {\n${binaryArms}                _ => RequestBody::Json(&body),\n            }` : 'RequestBody::Json(&body)',
        urlencoded: 'RequestBody::UrlEncoded(&body)',
        form: 'RequestBody::Multipart(body)',
        text: `RequestBody::Text(body, ${vars.toRustString(vars.getTextContentType(validation?.body))})`,
        binary: `RequestBody::Binary(body, ${vars.toRustString(validation?.body?.['x-contentType']?.[0] || 'application/octet-stream')})`,
    }[bodyKind];
%>
<% // without a body the function still takes body: (), every function takes the same arguments
if (bodyKind === 'none') { %>    #[allow(unused_variables)]
<% } %>    pub async fn <%= handlerName %>( 
        body: <%- bodyKind === 'form' ? 'reqwest::multipart::Form' : bodyKind !== 'none' ? `${handlerName}_::body` : '()' %>,
        query: <%- validation?.query ? `${handlerName}_::query` : '()' %>,
        params: <%- paramsType %>,
        headers: Option<&HashMap<String, String>>,
        api_root: Option<&str>,
        disable_client_validation: bool,
    ) -> <%- validation?.output ? `Result<${handlerName}_::output, HttpException>` : validation?.iteration ? `Result<Pin<Box<dyn Stream<Item = Result<${handlerName}_::iteration, HttpException>> + Send>>, HttpException>` : 'Result<serde_json::Value, HttpException>' %>{
        let result = <%= validation?.iteration ? 'http_request_stream' : 'http_request' %>::<
<%- [
                validation?.output ? `${handlerName}_::output` : validation?.iteration ? `${handlerName}_::iteration` : 'serde_json::Value',
                typedBody ? `${handlerName}_::body` : '()',
                validation?.query ? `${handlerName}_::query` : '()',
                paramsType
            ].filter(Boolean).map((s) => ' '.repeat(12) + s).join(',\n') %>
        >(
            &Endpoint {
                api_root: <%- vars.toRustString(apiRoot) %>,
                segment_path: <%- vars.toRustString(segmentPath) %>,
                segment_name: <%- vars.toRustString(segmentName) %>,
                controller_name: <%- vars.toRustString(controllerSchema.rpcModuleName) %>,
                handler_name: <%- vars.toRustString(handlerNameOriginal) %>,
            },
            <%- requestBody %>,
            Some(&query),
            Some(&params),
            headers,
            api_root,
            disable_client_validation,
        ).await;

        result
    }
        <% }) %>
}
    <% }) %>

<% }) %>

