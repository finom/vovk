---
imports: ['vovk-rust']
---
<%- t.getFirstLineBanner('html') %>
<% if (t.readme.banner) { %><%- t.readme.banner %>

<% } %># <%= t.underscoredPackageName %> v<%= t.package.version %> [![Rust](https://img.shields.io/badge/Rust-lang-000000.svg?style=flat&logo=rust)](https://www.rust-lang.org) [![Vovk.ts](https://badgen.net/badge/Built%20with/Vovk.ts/333333?icon=https://vovk.dev/icon-white.svg)](https://vovk.dev)

<%- t.readme.description ?? (`${t.package.description ? `> ${t.package.description}` : ''}`) %>

<%- t.package.license ? `License: **${t.package.license}**` : '' %>

<%
// the module names the crate has: in schema order, a taken name gets the first free suffix, as in lib.rs
const usedModuleNames = new Set(['http_request', 'read_full_schema']);
const moduleNames = new Map(
    Object.values(t.schema.segments)
        .flatMap((segment) => Object.values(segment.controllers))
        .map((controllerSchema) => [controllerSchema, t.imports['vovk-rust'].toRustIdent(t._.snakeCase(controllerSchema.rpcModuleName), usedModuleNames)])
);
// the samples come first: the install block lists the crates they use
const samples = new Map();
Object.values(t.schema.segments).forEach((segment) => Object.values(segment.controllers).forEach((controllerSchema) => {
    Object.entries(controllerSchema.handlers).forEach(([handlerName, handlerSchema]) => {
        samples.set(handlerSchema, t.createCodeSamples({
            handlerSchema,
            handlerName,
            controllerSchema,
            package: t.package,
            config: t.samples,
            rustModuleName: moduleNames.get(controllerSchema),
        }).rs);
    });
}));
const sampleCode = [...samples.values()].join('\n');
const sampleCrates = [
    ['tokio::', 'cargo add tokio --features macros,rt-multi-thread'],
    ['serde_json::', 'cargo add serde_json'],
    ['futures_util::', 'cargo add futures-util'],
    // the reqwest version the crate uses: another version's Form is another type
    ['reqwest::', 'cargo add reqwest@0.12 --features multipart'],
].filter(([cratePath]) => sampleCode.includes(cratePath));
-%>
```bash
# Install the package
<%= t.readme.installCommand ?? `cargo add ${t.underscoredPackageName}` %>
<% if (sampleCrates.length) { %># The samples below also use
<%- sampleCrates.map(([, command]) => command).join('\n') %>
<% } %>```

<% Object.entries(t.schema.segments).forEach(([segmentName, segment]) => {
    const segmentMeta = t.segmentMeta?.[segmentName] ?? {};
    const apiRoot = segmentMeta.forceApiRoot ?? t.apiRoot ?? '';
    const segmentPath = segment.forceApiRoot ? '' : typeof segmentMeta.segmentNameOverride === 'string' ? segmentMeta.segmentNameOverride : segmentName;
    Object.values(segment.controllers).forEach((controllerSchema) => {
    // the names the crate has
    const moduleName = moduleNames.get(controllerSchema);
    const functionNames = t.imports['vovk-rust'].getFunctionNames(Object.keys(controllerSchema.handlers), t._.snakeCase); %>

## mod <%= moduleName %>
        <% Object.entries(controllerSchema.handlers).forEach(([handlerName, handlerSchema]) => { %>
### <%= moduleName %>::<%= functionNames.get(handlerName) %>
<%- handlerSchema.operationObject?.summary ? `> ${handlerSchema.operationObject.summary}` : '' %>

<%- handlerSchema.operationObject?.description ? `${handlerSchema.operationObject.description}` : '' %>

`<%= handlerSchema.httpMethod %> <%= [t._.trimEnd(apiRoot, '/'), ...[segmentPath, controllerSchema.prefix ?? '', handlerSchema.path].map((part) => t._.trim(part, '/'))].filter(Boolean).join('/') %>`

```rust
<%- samples.get(handlerSchema) %>
```
        <% }) %>
    <% }) %>
<% }) %>
