<%
// the module names the crate has: in schema order, a taken name gets the first free suffix, as in lib.rs
const usedModuleNames = new Set(['http_request', 'read_full_schema']);
const moduleNames = new Map(
    Object.values(t.schema.segments)
        .flatMap((segment) => Object.values(segment.controllers))
        .map((controllerSchema) => [controllerSchema, t.imports['vovk-rust'].toRustIdent(t._.snakeCase(controllerSchema.rpcModuleName), usedModuleNames)])
);
// the functions of each handler with their samples, which come first: the install block lists the crates they use
const handlerFunctions = new Map();
Object.values(t.schema.segments).forEach((segment) => Object.values(segment.controllers).forEach((controllerSchema) => {
    const functionNames = t.imports['vovk-rust'].getFunctionNames(Object.keys(controllerSchema.handlers), t._.snakeCase);
    Object.entries(controllerSchema.handlers).forEach(([handlerName, handlerSchema]) => {
        const getSample = (givenSchema, rustFunctionName) => t.createCodeSamples({
            handlerSchema: givenSchema,
            handlerName,
            controllerSchema,
            package: t.package,
            config: t.samples,
            rustModuleName: moduleNames.get(controllerSchema),
            rustFunctionName,
        }).rs;
        const name = functionNames.get(handlerName);
        // a JSON-or-file body also has a function with _json, as in lib.rs
        const jsonFunction = t.imports['vovk-rust'].getJSONFunction(handlerSchema.validation?.body, name, functionNames);
        handlerFunctions.set(handlerSchema, [
            { name, sample: getSample(handlerSchema, name) },
            ...(jsonFunction ? [{
                name: jsonFunction.name,
                summary: 'Sends the branches of the body without a file as JSON',
                sample: getSample({ ...handlerSchema, validation: { ...handlerSchema.validation, body: jsonFunction.body } }, jsonFunction.name),
            }] : []),
        ]);
    });
}));
const sampleCode = [...handlerFunctions.values()].flat().map(({ sample }) => sample).join('\n');
const sampleCrates = [
    ['tokio::', 'cargo add tokio --features macros,rt-multi-thread'],
    ['serde_json::', 'cargo add serde_json'],
    ['futures_util::', 'cargo add futures-util'],
    // the reqwest version the crate uses: another version's Form is another type
    ['reqwest::', 'cargo add reqwest@0.12 --features multipart'],
].filter(([cratePath]) => sampleCode.includes(cratePath));
-%>
