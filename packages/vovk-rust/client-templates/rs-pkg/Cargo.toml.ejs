<%- t.getFirstLineBanner('sh') %>
<%
const data = {
  package: {
    name: t.underscoredPackageName,
    version: t.package.version,
    edition: "2021",
    // the oldest Rust the crate builds on; resolver 3 picks dependency versions that build on it
    "rust-version": "1.85",
    resolver: "3"
  },
  dependencies: {
    // untagged variants, which mixed enums use, came in 1.0.164
    serde: { version: "1.0.164", features: ["derive"] },
    // jsonschema asks for any 1.x but needs the Default impls 1.0.143 added
    serde_json: "1.0.143",
    reqwest: { version: "0.12", features: ["json", "multipart", "stream"] },
    // Handle::id, which keeps a client per runtime, came in 1.49
    tokio: { version: "1.49", features: ["macros", "rt-multi-thread", "io-util"] },
    "futures-util": "0.3",
    "tokio-util": { version: "0.7", features: ["codec"] },
    // default features fetch remote schemas over HTTP, which the client never does
    jsonschema: { version: "0.57", "default-features": false },
    urlencoding: "2.1",
    once_cell: "1.17"
  }
};

if (t.package.description) {
  data.package.description = t.package.description;
}

if (t.package.license) {
  data.package.license = t.package.license;
}

// crates.io takes only an http(s) URL; npm writes git+https:// or git+ssh:// and allows shorthands such as github:owner/repo
const repository = typeof t.package.repository === 'string' ? t.package.repository : t.package.repository?.url;
if (typeof repository === 'string') {
  const shorthand = /^(?:(github|gitlab|bitbucket):)?([\w-][\w.-]*\/[\w.-]+)$/.exec(repository);
  const repositoryUrl = shorthand
    ? `https://${{ github: 'github.com', gitlab: 'gitlab.com', bitbucket: 'bitbucket.org' }[shorthand[1] ?? 'github']}/${shorthand[2]}`
    : repository
        .replace(/^git\+/, '')
        .replace(/^(?:git|ssh):\/\/(?:git@)?/, 'https://')
        .replace(/^git@([^:/]+):/, 'https://$1/');
  if (/^https?:\/\//.test(repositoryUrl)) {
    data.package.repository = repositoryUrl;
  }
}

if (/^https?:\/\//.test(t.package.homepage)) {
  data.package.homepage = t.package.homepage;
}

const authors = [];
if (t.package.author) {
  if (typeof t.package.author === 'string') {
    authors.push(t.package.author);
  } else {
    let author = t.package.author.name;
    if (t.package.author.email) author += ` <${t.package.author.email}>`;
    authors.push(author);
  }
}

if (t.package.contributors && t.package.contributors.length) {
  t.package.contributors.forEach(contributor => {
    if (typeof contributor === 'string') {
      authors.push(contributor);
    } else {
      let contribStr = contributor.name;
      if (contributor.email) contribStr += ` <${contributor.email}>`;
      authors.push(contribStr);
    }
  });
}

if (authors.length) {
  data.package.authors = authors;
}

// crates.io takes at most 5 keywords of up to 20 characters: a letter or digit, then letters, digits, _, - or +
const keywords = (Array.isArray(t.package.keywords) ? t.package.keywords : [])
  .filter((keyword) => typeof keyword === 'string' && /^[A-Za-z0-9][A-Za-z0-9_+-]{0,19}$/.test(keyword))
  .slice(0, 5);
if (keywords.length) {
  data.package.keywords = keywords;
}

if (t.package.bugs) {
  if (!data.package.metadata) {
    data.package.metadata = {};
  }
  
  data.package.metadata.package = {
    bugs: typeof t.package.bugs === 'string' 
      ? t.package.bugs 
      : t.package.bugs.url
  };
}
%>
<%- t.TOML.stringify(data) %>