{
  "name": "vovk",
  "type": "module",
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "bin",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "version": "4.1.1",
  "bin": {
    "vovk-cli-npx": "./bin/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./fetcher": {
      "types": "./dist/client/fetcher.d.ts",
      "default": "./dist/client/fetcher.js"
    },
    "./create-rpc": {
      "types": "./dist/client/create-rpc.d.ts",
      "default": "./dist/client/create-rpc.js"
    },
    "./create-validate-on-client": {
      "types": "./dist/validation/create-validate-on-client.d.ts",
      "default": "./dist/validation/create-validate-on-client.js"
    }
  },
  "description": "Back-end Framework for Next.js App Router",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finom/vovk.git",
    "directory": "packages/vovk"
  },
  "scripts": {
    "postbuild": "chmod +x ./bin/index.mjs",
    "build": "rm -f *.tsbuildinfo && tsc",
    "rm-dist": "rm -rf dist mjs cjs",
    "lint": "biome check --fix",
    "tsc": "tsc --noEmit && tsc --noEmit -p test",
    "test": "NODE_ENV=test node --experimental-strip-types --test --test-concurrency=1 test/unit/*.test.ts",
    "test-only": "NODE_ENV=test node --experimental-strip-types --test --test-only --test-concurrency=1 test/unit/*.test.ts",
    "prepublishOnly": "node -e \"if (!process.env.GITHUB_ACTIONS) { console.error('Publish from CI: PACKAGE=<name> npm run <type> tags a release, and the tag publishes it'); process.exit(1) }\"",
    "ncu": "npm-check-updates -u --cooldown 7"
  },
  "keywords": [
    "nextjs",
    "router"
  ],
  "author": "Andrey Gubanov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/finom/vovk/issues"
  },
  "homepage": "https://vovk.dev",
  "peerDependencies": {
    "openapi3-ts": "^4.5.0"
  },
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "@valibot/to-json-schema": "^1.8.0",
    "ajv": "^8.20.0",
    "arktype": "^2.2.7",
    "fast-check": "^4.10.2",
    "next": "^16.3.8",
    "openapi3-ts": "^4.6.1",
    "standard-tool": "^0.1.1",
    "type-fest": "^5.10.0",
    "valibot": "^1.5.0",
    "zod": "^4.6.5"
  }
}
