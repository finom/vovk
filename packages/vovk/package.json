{
  "name": "vovk",
  "type": "module",
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "bin",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "version": "4.0.0-beta.0",
  "bin": {
    "vovk-cli-npx": "./bin/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./fetcher": {
      "types": "./dist/client/fetcher.d.ts",
      "default": "./dist/client/fetcher.js"
    },
    "./create-rpc": {
      "types": "./dist/client/create-rpc.d.ts",
      "default": "./dist/client/create-rpc.js"
    },
    "./create-validate-on-client": {
      "types": "./dist/validation/create-validate-on-client.d.ts",
      "default": "./dist/validation/create-validate-on-client.js"
    }
  },
  "description": "Back-end Framework for Next.js App Router",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finom/vovk.git",
    "directory": "packages/vovk"
  },
  "scripts": {
    "postbuild": "chmod +x ./bin/index.mjs",
    "build": "rm -f *.tsbuildinfo && tsc",
    "rm-dist": "rm -rf dist mjs cjs",
    "lint": "biome check --fix",
    "tsc": "tsc --noEmit",
    "prepublishOnly": "node -e \"if (!process.env.GITHUB_ACTIONS) { console.error('Publish from CI: PACKAGE=<name> npm run <type> tags a release, and the tag publishes it'); process.exit(1) }\"",
    "ncu": "npm-check-updates -u"
  },
  "keywords": [
    "nextjs",
    "router"
  ],
  "author": "Andrey Gubanov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/finom/vovk/issues"
  },
  "homepage": "https://vovk.dev",
  "peerDependencies": {
    "openapi3-ts": "^4.5.0"
  }
}
