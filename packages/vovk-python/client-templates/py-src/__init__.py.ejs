---
imports: ['vovk-python']
---
<%- t.getFirstLineBanner('sh') %>
<% const vars = {
    convertJSONSchemaToPythonDataType: t.imports['vovk-python'].convertJSONSchemaToPythonDataType,
    convertJSONSchemaToPythonFilesType: t.imports['vovk-python'].convertJSONSchemaToPythonFilesType,
    hasFiles: t.imports['vovk-python'].hasFiles,
    hasNormalData: t.imports['vovk-python'].hasNormalData,
    getBodyKind: t.imports['vovk-python'].getBodyKind,
    toPythonString: t.imports['vovk-python'].toPythonString,
    toPythonIdentifier: t.imports['vovk-python'].toPythonIdentifier,
    toPythonDocstringLines: t.imports['vovk-python'].toPythonDocstringLines,
    toPythonCommentText: t.imports['vovk-python'].toPythonCommentText
};
// the root a segment's URLs start with and the segment's path after it; a mixin's root is its API's server
const segmentBases = Object.fromEntries(Object.entries(t.schema.segments).map(([segmentName, segment]) => {
    const meta = t.segmentMeta[segment.segmentName] ?? {};
    const path = segment.forceApiRoot ? '' : typeof meta.segmentNameOverride === 'string' ? meta.segmentNameOverride : segmentName;
    return [segmentName, [meta.forceApiRoot ?? t.apiRoot ?? '', path]];
}));
const joinURL = (root, ...parts) => [root.replace(/\/+$/, ''), ...parts.map((part) => t._.trim(part ?? '', '/'))].filter(Boolean).join('/'); %>
from __future__ import annotations
import sys
from typing import Any, Dict, List, Literal, Optional, Set, TypedDict, Union, Tuple, Generator, BinaryIO # type: ignore
from .api_client import ApiClient, HttpException

if sys.version_info >= (3, 11):
    from typing import NotRequired
else:
    from typing_extensions import NotRequired

HttpException = HttpException

client = ApiClient(<%- vars.toPythonString(t.apiRoot ?? '') %>, {
<%- Object.entries(segmentBases).map(([segmentName, [root, path]]) => `    ${vars.toPythonString(segmentName)}: (${vars.toPythonString(root)}, ${vars.toPythonString(path)}),`).join('\n') %>
})
<% Object.entries(t.schema.segments).forEach(([segmentName, segment]) => {
    Object.values(segment.controllers).forEach((controllerSchema) => {
const { rpcModuleName } = controllerSchema;
const pyModuleName = vars.toPythonIdentifier(rpcModuleName); %>
class <%- pyModuleName %>: <% if (!Object.keys(controllerSchema.handlers).length) { %>
    pass<% } %><% Object.entries(controllerSchema.handlers).forEach(([handlerNameOriginal, handlerSchema]) => {
    const { validation, operationObject, httpMethod } = handlerSchema;
    const handlerNameOriginalCapitalized = vars.toPythonIdentifier(handlerNameOriginal.charAt(0).toUpperCase() + handlerNameOriginal.slice(1));
    const handlerName = vars.toPythonIdentifier(t._.snakeCase(handlerNameOriginal));
    const bodyKind = vars.getBodyKind(validation?.body);
    const firstContentType = validation?.body?.['x-contentType']?.[0] || 'application/octet-stream'; %>
    # <%- vars.toPythonCommentText(`${rpcModuleName}.${handlerName} ${httpMethod} \`${joinURL(...segmentBases[segmentName], controllerSchema.prefix, handlerSchema.path)}\``) %>
<%- ([
        bodyKind === 'text' ? '' : bodyKind === 'binary' ? '' : vars.convertJSONSchemaToPythonDataType({ schema: validation?.body, namespace: pyModuleName, className: `${handlerNameOriginalCapitalized}Body`, pad: 4 }),
        vars.convertJSONSchemaToPythonFilesType({ schema: validation?.body, namespace: pyModuleName, className: `${handlerNameOriginalCapitalized}Files`, pad: 4 }),
        vars.convertJSONSchemaToPythonDataType({ schema: validation?.query, namespace: pyModuleName, className: `${handlerNameOriginalCapitalized}Query`, pad: 4 }),
        vars.convertJSONSchemaToPythonDataType({ schema: validation?.params, namespace: pyModuleName, className: `${handlerNameOriginalCapitalized}Params`, pad: 4 }),
        vars.convertJSONSchemaToPythonDataType({ schema: t.reattachMixinDefs(validation?.output, segment), namespace: pyModuleName, className: `${handlerNameOriginalCapitalized}Output`, pad: 4 }),
        vars.convertJSONSchemaToPythonDataType({ schema: t.reattachMixinDefs(validation?.iteration, segment), namespace: pyModuleName, className: `${handlerNameOriginalCapitalized}Iteration`, pad: 4 })
    ]).filter(Boolean).join('\n') %>
    @staticmethod
    def <%= handlerName %>(
<%= [
            bodyKind === 'text' ? 'body: str,' : bodyKind === 'binary' ? 'body: bytes,' : '',
            bodyKind === 'json' || (bodyKind === 'form' && vars.hasNormalData(validation.body)) ? `body: ${handlerNameOriginalCapitalized}Body,` : '',
            validation?.body && vars.hasFiles(validation.body) ? `files: ${handlerNameOriginalCapitalized}Files,` : '',
            validation?.query ? `query: ${handlerNameOriginalCapitalized}Query,` : '',
            validation?.params ? `params: ${handlerNameOriginalCapitalized}Params,` : ''
        ].filter(Boolean).map((s) => ' '.repeat(8) + s).join('\n') %>
        headers: Optional[Dict[str, str]] = None,
        api_root: Optional[str] = None,
        disable_client_validation: bool = False
    ) -> <%= validation?.output ? `${handlerNameOriginalCapitalized}Output` : validation?.iteration ? `Generator[${handlerNameOriginalCapitalized}Iteration, None, None]` : 'Any' %>:
        """ 
<%- ([
                operationObject?.summary ?? 'No summary',
                operationObject?.description ? `Description: ${operationObject.description}` : '',
                validation?.body?.description ? `Body: ${validation?.body?.description}`: '',
                validation?.query?.description ? `Query: ${validation?.query?.description}`: '',
                validation?.output?.description ? `Returns: ${validation?.output?.description}`: ''
            ]).filter(Boolean).flatMap((s) => vars.toPythonDocstringLines(s)).map((s) => ' '.repeat(8) + s).join('\n') %>
        """
        return client.request( # type: ignore
            segment_name=<%- vars.toPythonString(segmentName) %>,
            rpc_name=<%- vars.toPythonString(rpcModuleName) %>,
            handler_name=<%- vars.toPythonString(handlerNameOriginal) %>,
<%- [
                bodyKind === 'text' || bodyKind === 'binary' ? 'body=body,' : '',
                bodyKind === 'json' || (bodyKind === 'form' && vars.hasNormalData(validation.body)) ? 'body=body,' : '',
                validation?.body && vars.hasFiles(validation.body) ? 'files=files,' : '',
                bodyKind === 'text' || bodyKind === 'binary' ? `body_content_type=${vars.toPythonString(firstContentType)},` : '',
                validation?.query ? 'query=query,' : '',
                validation?.params ? 'params=params,' : ''
            ].filter(Boolean).map((s) => ' '.repeat(12) + s).join('\n') %>
            headers=headers,
            api_root=api_root,
            disable_client_validation=disable_client_validation
        )
        <% }) %>
    <% }) %>
<% }) %>
