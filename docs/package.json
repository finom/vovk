{
  "name": "vovk.dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run lint && tsc --noEmit && tsx --test scripts/generateContext/contextTransforms.test.ts",
    "predev": "npm run update-mdx-github-codeblocks",
    "dev": "vovk dev --next-dev",
    "dev-exit": "vovk dev --next-dev --exit",
    "build": "next build",
    "prebuild": "vovk generate && tsx ./scripts/generateContext/index.ts",
    "start": "next start",
    "lint": "biome check",
    "output-cli": "FORCE_COLOR=1 npx vovk-cli init@draft --channel=draft | npx ansi-to-html > output.html",
    "generate": "vovk generate",
    "postbuild": "pagefind --site .next/server/app --output-path out/_pagefind",
    "update-mdx-github-codeblocks": "tsx ./scripts/updateMDXFilesWithGithubContent.ts",
    "ncu": "npm-check-updates -u"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@scalar/api-reference-react": "^0.9.60",
    "@types/json-schema": "^7.0.15",
    "asciinema-player": "^3.17.0",
    "bright": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.28.0",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-syntax-highlighter": "^16.1.1",
    "react-transition-group": "^4.4.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "vovk": "^4.0.0-beta.0",
    "vovk-ajv": "^0.1.0",
    "vovk-examples": "^3.0.22",
    "zod": "^4.4.3"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "printWidth": 120
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/react-transition-group": "^4.4.12",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "shiki": "^4.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "user-agent-data-types": "^0.4.3",
    "vovk-cli": "^0.3.0-beta.0"
  }
}
