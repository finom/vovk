{
  "name": "vovk-examples",
  "version": "3.0.22",
  "description": "Vovk examples",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "vovk"
  ],
  "scripts": {
    "test": "npm run lint",
    "ncu": "npm-check-updates -u",
    "predev": "npm run update-mdx-github-codeblocks",
    "dev": "vovk dev --next-dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "check-uncommitted": "git diff --quiet && git diff --cached --quiet || (echo '❌ Uncommitted changes!' && exit 1)",
    "git-tag": "git add . && git commit -m \"chore: release v$(node -p \"require('./package.json').version\")\" && git tag vovk-examples-v$(node -p \"require('./package.json').version\")",
    "patch": "npm run check-uncommitted && npm t && npm version patch --no-workspaces-update",
    "minor": "npm run check-uncommitted && npm t && npm version minor --no-workspaces-update",
    "BREAKING-major": "npm run check-uncommitted && npm t && npm version major --no-workspaces-update",
    "postversion": "npm run bundle && npm publish ./dist && npm run git-tag && git push && git push --tags",
    "generate": "vovk generate",
    "bundle": "NODE_ENV=production vovk bundle",
    "prebuild": "vovk generate",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "vercel-build": "npm run build",
    "update-mdx-github-codeblocks": "node --experimental-strip-types ./scripts/updateMDXFilesWithGithubContent.ts"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "printWidth": 120
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/finom/vovk.git",
    "directory": "examples/kitchen-sink"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/react": "^4.0.129",
    "@hookform/resolvers": "^5.9.1",
    "@scalar/api-reference-react": "^0.9.76",
    "@tanstack/react-query": "^5.104.0",
    "@valibot/to-json-schema": "^1.8.0",
    "ai": "^7.0.126",
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "arktype": "^2.2.6",
    "bright": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lodash": "^4.18.1",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "openai": "^7.25.0",
    "openapi3-ts": "^4.6.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-loading-skeleton": "^3.5.0",
    "react-to-string": "^0.1.1",
    "tailwind-merge": "^3.7.0",
    "tsdown": "^0.22.14",
    "valibot": "^1.5.0",
    "vovk": "^4.0.0-beta.0",
    "vovk-ajv": "^0.1.0",
    "yup": "^1.7.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "pagefind": "^1.5.2",
    "postcss": "^8",
    "prettier": "^3.9.9",
    "reflect-metadata": "^0.2.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vovk-cli": "^0.3.0-beta.0",
    "vovk-python": "^0.0.3",
    "vovk-rust": "^0.0.4"
  }
}
